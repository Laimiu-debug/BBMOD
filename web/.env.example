# Run python3 tools/init_env.py --host YOUR_SERVER_IP to generate a private .env.
BBMOD_SECRET_KEY=generate-a-new-random-secret-do-not-use-this-example
BBMOD_ALLOWED_HOSTS=127.0.0.1,localhost,YOUR_SERVER_IP
BBMOD_DEBUG=0
BBMOD_HTTPS=0
BBMOD_BIND=0.0.0.0
BBMOD_PORT=8080
BBMOD_MAX_UPLOAD_MB=100
BBMOD_AUTHOR_QUOTA_MB=2048
